schema{
    query: Query
    mutation: Mutation
}


type Query{

    getAllUsers: [User!]!
    
}

type Mutation{

    createUserAccount(userInput: UserInput!): User!

}

input UserInput{
    name: String!
    email: String!
    phoneNo: String!
    dob: String
    avatarUrl: String
}

type User{

    id: ID!
    name: String!
    email: String!
    phoneNo: String!
    dob: String
    avatarUrl: String


}
